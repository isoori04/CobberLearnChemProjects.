from __future__ import annotations

import copy
import csv
import os
import sys
import webbrowser
from pathlib import Path
from typing import List, Tuple, Dict, Optional

import numpy as np
import matplotlib.pyplot as plt
from Bio.Align import PairwiseAligner
from Bio.PDB import PDBParser, PDBIO, Superimposer, is_aa
from Bio.SeqUtils import seq1


def choose_pdb_files() -> Tuple[Path, Path]:
    """Ask the user to choose the experimental and AlphaFold PDB files."""
    try:
        import tkinter as tk
        from tkinter import filedialog, messagebox
    except Exception as exc:
        raise RuntimeError(
            "Tkinter is not available. Either install Tk support or hard-code the PDB paths in the script."
        ) from exc

    root = tk.Tk()
    root.withdraw()
    root.update()

    messagebox.showinfo(
        "Select experimental structure",
        "Choose the experimental PDB file (for example: 1TRZ_chain_A_cleaned.pdb).",
    )
    exp_file = filedialog.askopenfilename(
        title="Select experimental PDB file",
        filetypes=[("PDB files", "*.pdb"), ("All files", "*.*")],
        initialdir=os.getcwd(),
    )

    if not exp_file:
        raise FileNotFoundError("No experimental PDB file was selected.")

    messagebox.showinfo(
        "Select AlphaFold prediction",
        "Choose the AlphaFold PDB file (for example: [jobname]_relaxed_rank_001.pdb).",
    )
    pred_file = filedialog.askopenfilename(
        title="Select AlphaFold PDB file",
        filetypes=[("PDB files", "*.pdb"), ("All files", "*.*")],
        initialdir=os.getcwd(),
    )

    if not pred_file:
        raise FileNotFoundError("No AlphaFold PDB file was selected.")

    root.destroy()
    return Path(exp_file), Path(pred_file)


def load_structure(pdb_path: Path, structure_id: str):
    parser = PDBParser(QUIET=True)
    return parser.get_structure(structure_id, str(pdb_path))


def get_protein_residues(structure) -> List:
    """Return standard amino-acid residues that contain a CA atom."""
    residues = []
    for model in structure:
        for chain in model:
            for residue in chain:
                if is_aa(residue, standard=True) and residue.has_id("CA"):
                    residues.append(residue)
        break  # use the first model only
    return residues


def residue_to_one_letter(residue) -> str:
    try:
        return seq1(residue.get_resname())
    except Exception:
        return "X"


def residue_label(residue) -> str:
    chain_id = residue.get_parent().id
    hetflag, resseq, icode = residue.id
    insertion = icode.strip() if icode.strip() else ""
    return f"{chain_id}:{resseq}{insertion}"


def extract_sequence_and_residues(structure) -> Tuple[str, List]:
    residues = get_protein_residues(structure)
    sequence = "".join(residue_to_one_letter(res) for res in residues)
    return sequence, residues


def get_structure_stats(structure) -> Dict[str, int]:
    model = next(structure.get_models())
    chains = list(model.get_chains())
    residues = [res for res in model.get_residues()]
    atoms = [atom for atom in model.get_atoms()]
    protein_residues = get_protein_residues(structure)

    return {
        "models": len(list(structure.get_models())),
        "chains": len(chains),
        "residues_total": len(residues),
        "protein_residues_with_CA": len(protein_residues),
        "atoms": len(atoms),
    }


def align_sequences(seq1_str: str, seq2_str: str) -> List[Tuple[int, int]]:
    """Return matched residue-index pairs from a global sequence alignment."""
    aligner = PairwiseAligner()
    aligner.mode = "global"
    aligner.match_score = 2.0
    aligner.mismatch_score = -1.0
    aligner.open_gap_score = -10.0
    aligner.extend_gap_score = -0.5

    alignment = aligner.align(seq1_str, seq2_str)[0]
    pairs: List[Tuple[int, int]] = []

    for (start1, end1), (start2, end2) in zip(alignment.aligned[0], alignment.aligned[1]):
        block_len = min(end1 - start1, end2 - start2)
        for offset in range(block_len):
            pairs.append((start1 + offset, start2 + offset))

    return pairs


def get_matched_ca_atoms(exp_residues: List, pred_residues: List, matched_pairs: List[Tuple[int, int]]):
    fixed_atoms = []
    moving_atoms = []
    matched_residue_pairs = []

    for exp_idx, pred_idx in matched_pairs:
        exp_res = exp_residues[exp_idx]
        pred_res = pred_residues[pred_idx]

        if exp_res.has_id("CA") and pred_res.has_id("CA"):
            fixed_atoms.append(exp_res["CA"])
            moving_atoms.append(pred_res["CA"])
            matched_residue_pairs.append((exp_res, pred_res))

    if len(fixed_atoms) < 3:
        raise ValueError(
            "Need at least 3 matched CA atoms to perform structural superposition."
        )

    return fixed_atoms, moving_atoms, matched_residue_pairs


def superimpose_structures(exp_structure, pred_structure, fixed_atoms, moving_atoms):
    """Align the predicted structure onto the experimental structure."""
    superimposer = Superimposer()
    superimposer.set_atoms(fixed_atoms, moving_atoms)
    superimposer.apply(list(pred_structure.get_atoms()))
    return superimposer


def calculate_per_residue_distances(matched_residue_pairs: List[Tuple]) -> List[float]:
    distances = []
    for exp_res, pred_res in matched_residue_pairs:
        d = exp_res["CA"] - pred_res["CA"]
        distances.append(float(d))
    return distances


def get_residue_plddt(residue) -> float:
    """Average B-factor over all atoms in a residue; AlphaFold stores pLDDT in the B-factor column."""
    atom_bfactors = [atom.get_bfactor() for atom in residue.get_atoms()]
    return float(np.mean(atom_bfactors))


def save_structure(structure, output_path: Path) -> None:
    io = PDBIO()
    io.set_structure(structure)
    io.save(str(output_path))


def plot_per_residue_distances(
    matched_residue_pairs: List[Tuple],
    distances: List[float],
    output_path: Path,
) -> None:
    x = np.arange(1, len(distances) + 1)
    labels = [residue_label(exp_res) for exp_res, _ in matched_residue_pairs]

    plt.figure(figsize=(12, 5))
    plt.plot(x, distances, marker="o", linewidth=1)
    plt.xlabel("Matched residue position")
    plt.ylabel("CA distance after alignment (Å)")
    plt.title("Per-residue structural differences")
    plt.grid(True, alpha=0.3)

    if len(labels) <= 25:
        plt.xticks(x, labels, rotation=90)
    else:
        tick_step = max(1, len(x) // 20)
        tick_positions = x[::tick_step]
        tick_labels = labels[::tick_step]
        plt.xticks(tick_positions, tick_labels, rotation=90)

    plt.tight_layout()
    plt.savefig(output_path, dpi=300, bbox_inches="tight")
    plt.close()


def plot_plddt_scores(pred_residues: List, output_path: Path) -> List[float]:
    plddt_scores = [get_residue_plddt(res) for res in pred_residues]
    x = np.arange(1, len(plddt_scores) + 1)

    plt.figure(figsize=(12, 5))
    plt.plot(x, plddt_scores, linewidth=1.5)
    plt.axhline(90, linestyle="--", linewidth=1, alpha=0.7, label="Very high confidence")
    plt.axhline(70, linestyle="--", linewidth=1, alpha=0.7, label="Confident")
    plt.axhline(50, linestyle="--", linewidth=1, alpha=0.7, label="Low confidence cutoff")
    plt.xlabel("AlphaFold residue position")
    plt.ylabel("pLDDT score")
    plt.title("AlphaFold confidence (pLDDT) along the sequence")
    plt.ylim(0, 100)
    plt.grid(True, alpha=0.3)
    plt.legend()
    plt.tight_layout()
    plt.savefig(output_path, dpi=300, bbox_inches="tight")
    plt.close()

    return plddt_scores


def plot_plddt_vs_distance(
    matched_residue_pairs: List[Tuple],
    distances: List[float],
    output_path: Path,
) -> Optional[float]:
    matched_plddt = [get_residue_plddt(pred_res) for _, pred_res in matched_residue_pairs]

    if len(matched_plddt) < 2:
        return None

    correlation = float(np.corrcoef(matched_plddt, distances)[0, 1])

    plt.figure(figsize=(7, 5))
    plt.scatter(matched_plddt, distances, alpha=0.8)
    if len(matched_plddt) >= 2:
        coeffs = np.polyfit(matched_plddt, distances, 1)
        xfit = np.linspace(min(matched_plddt), max(matched_plddt), 200)
        yfit = np.polyval(coeffs, xfit)
        plt.plot(xfit, yfit, linewidth=1.5)
    plt.xlabel("AlphaFold pLDDT score")
    plt.ylabel("CA distance after alignment (Å)")
    plt.title("pLDDT vs. structural deviation")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(output_path, dpi=300, bbox_inches="tight")
    plt.close()

    return correlation


def write_results_csv(
    matched_residue_pairs: List[Tuple],
    distances: List[float],
    output_path: Path,
) -> None:
    with output_path.open("w", newline="", encoding="utf-8") as handle:
        writer = csv.writer(handle)
        writer.writerow(
            [
                "matched_position",
                "experimental_residue",
                "experimental_resname",
                "alphafold_residue",
                "alphafold_resname",
                "CA_distance_A",
                "AlphaFold_pLDDT",
            ]
        )
        for idx, ((exp_res, pred_res), distance) in enumerate(zip(matched_residue_pairs, distances), start=1):
            writer.writerow(
                [
                    idx,
                    residue_label(exp_res),
                    exp_res.get_resname(),
                    residue_label(pred_res),
                    pred_res.get_resname(),
                    f"{distance:.4f}",
                    f"{get_residue_plddt(pred_res):.2f}",
                ]
            )


def write_pymol_script(exp_pdb_name: str, aligned_pred_pdb_name: str, output_path: Path) -> None:
    pymol_script = f"""reinitialize
load {exp_pdb_name}, experimental
load {aligned_pred_pdb_name}, alphafold
hide everything
show cartoon, experimental
show cartoon, alphafold
color blue, experimental
color red, alphafold
set cartoon_transparency, 0.15, experimental
set cartoon_transparency, 0.15, alphafold
bg_color white
orient
zoom
"""
    output_path.write_text(pymol_script, encoding="utf-8")


def build_ngl_fallback_html(
    experimental_pdb_path: Path,
    aligned_pred_pdb_path: Path,
    output_path: Path,
) -> None:
    exp_text = experimental_pdb_path.read_text(encoding="utf-8", errors="ignore")
    pred_text = aligned_pred_pdb_path.read_text(encoding="utf-8", errors="ignore")

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Protein structure alignment</title>
  <script src="https://unpkg.com/ngl@latest/dist/ngl.js"></script>
  <style>
    body {{ margin: 0; font-family: Arial, sans-serif; }}
    #viewport {{ width: 100vw; height: 100vh; }}
    .label {{
      position: absolute;
      top: 12px;
      left: 12px;
      background: rgba(255,255,255,0.9);
      padding: 10px 12px;
      border-radius: 8px;
      z-index: 10;
      line-height: 1.4;
    }}
  </style>
</head>
<body>
<div class="label">
  <strong>Overlay</strong><br>
  Experimental = blue<br>
  AlphaFold = red
</div>
<div id="viewport"></div>
<script>
  const stage = new NGL.Stage("viewport", {{ backgroundColor: "white" }});

  function blobFromText(text) {{
    return new Blob([text], {{ type: "text/plain" }});
  }}

  const experimentalText = {exp_text!r};
  const alphafoldText = {pred_text!r};

  Promise.all([
    stage.loadFile(blobFromText(experimentalText), {{ ext: "pdb" }}),
    stage.loadFile(blobFromText(alphafoldText), {{ ext: "pdb" }})
  ]).then(function(components) {{
    components[0].addRepresentation("cartoon", {{ color: "blue" }});
    components[1].addRepresentation("cartoon", {{ color: "red" }});
    stage.autoView();
  }});

  window.addEventListener("resize", function() {{
    stage.handleResize();
  }});
</script>
</body>
</html>
"""
    output_path.write_text(html, encoding="utf-8")


def try_write_nglview_html(
    experimental_pdb_path: Path,
    aligned_pred_pdb_path: Path,
    output_path: Path,
) -> str:
    """
    Try to export an HTML viewer with nglview.
    If that fails, write a browser-based NGL fallback HTML instead.
    """
    try:
        import nglview as nv

        view = nv.show_file(str(experimental_pdb_path))
        view.clear_representations(component=0)
        view.add_representation("cartoon", selection="protein", color="blue")

        pred_component = view.add_component(str(aligned_pred_pdb_path))
        view.clear_representations(component=1)
        pred_component.add_representation("cartoon", selection="protein", color="red")

        try:
            view.center()
        except Exception:
            pass

        nv.write_html(str(output_path), [view])
        return "NGLView HTML export succeeded."
    except Exception as exc:
        build_ngl_fallback_html(experimental_pdb_path, aligned_pred_pdb_path, output_path)
        return (
            "NGLView HTML export was not available on this system, so a browser-based "
            f"NGL fallback HTML was written instead. Details: {exc}"
        )


def print_stats(title: str, stats: Dict[str, int], sequence: str) -> None:
    print(f"\n{title}")
    print("-" * len(title))
    print(f"Models: {stats['models']}")
    print(f"Chains: {stats['chains']}")
    print(f"Total residues: {stats['residues_total']}")
    print(f"Protein residues with CA: {stats['protein_residues_with_CA']}")
    print(f"Atoms: {stats['atoms']}")
    print(f"Sequence length used for comparison: {len(sequence)}")


def main() -> None:
    try:
        exp_path, pred_path = choose_pdb_files()
    except Exception as exc:
        print(f"File selection failed: {exc}")
        sys.exit(1)

    output_dir = exp_path.parent

    print(f"\nExperimental PDB: {exp_path}")
    print(f"AlphaFold PDB:   {pred_path}")

    exp_structure = load_structure(exp_path, "experimental")
    pred_structure = load_structure(pred_path, "alphafold")
    pred_structure_aligned = copy.deepcopy(pred_structure)

    exp_sequence, exp_residues = extract_sequence_and_residues(exp_structure)
    pred_sequence, pred_residues = extract_sequence_and_residues(pred_structure_aligned)

    if not exp_residues:
        raise ValueError("No protein residues with CA atoms were found in the experimental structure.")
    if not pred_residues:
        raise ValueError("No protein residues with CA atoms were found in the AlphaFold structure.")

    print_stats("Experimental structure statistics", get_structure_stats(exp_structure), exp_sequence)
    print_stats("AlphaFold structure statistics", get_structure_stats(pred_structure), pred_sequence)

    matched_pairs = align_sequences(exp_sequence, pred_sequence)
    fixed_atoms, moving_atoms, matched_residue_pairs = get_matched_ca_atoms(
        exp_residues, pred_residues, matched_pairs
    )

    superimposer = superimpose_structures(
        exp_structure,
        pred_structure_aligned,
        fixed_atoms,
        moving_atoms,
    )

    distances = calculate_per_residue_distances(matched_residue_pairs)

    reference_copy_path = output_dir / "experimental_reference.pdb"
    aligned_pred_path = output_dir / "alphafold_aligned_to_experimental.pdb"
    distance_plot_path = output_dir / "per_residue_distances.png"
    plddt_plot_path = output_dir / "plddt_scores.png"
    correlation_plot_path = output_dir / "plddt_vs_distance.png"
    csv_path = output_dir / "comparison_results.csv"
    pymol_script_path = output_dir / "visualize_alignment.pml"
    html_path = output_dir / "alignment_view.html"

    save_structure(exp_structure, reference_copy_path)
    save_structure(pred_structure_aligned, aligned_pred_path)

    plot_per_residue_distances(matched_residue_pairs, distances, distance_plot_path)
    all_plddt_scores = plot_plddt_scores(get_protein_residues(pred_structure), plddt_plot_path)
    correlation = plot_plddt_vs_distance(matched_residue_pairs, distances, correlation_plot_path)
    write_results_csv(matched_residue_pairs, distances, csv_path)
    write_pymol_script(reference_copy_path.name, aligned_pred_path.name, pymol_script_path)
    html_status = try_write_nglview_html(reference_copy_path, aligned_pred_path, html_path)

    rmsd = float(superimposer.rms)
    mean_distance = float(np.mean(distances))
    max_distance = float(np.max(distances))
    max_index = int(np.argmax(distances))
    worst_exp_res, worst_pred_res = matched_residue_pairs[max_index]
    worst_plddt = get_residue_plddt(worst_pred_res)

    print("\nComparison results")
    print("------------------")
    print(f"Matched residues used for superposition: {len(matched_residue_pairs)}")
    print(f"Backbone CA RMSD: {rmsd:.3f} Å")
    print(f"Mean per-residue CA distance: {mean_distance:.3f} Å")
    print(
        f"Largest per-residue difference: {max_distance:.3f} Å "
        f"at experimental residue {residue_label(worst_exp_res)} "
        f"vs AlphaFold residue {residue_label(worst_pred_res)}"
    )
    print(f"AlphaFold pLDDT at the largest-difference residue: {worst_plddt:.2f}")
    if correlation is not None:
        print(f"Correlation (pLDDT vs distance): {correlation:.3f}")

    if rmsd < 1.0:
        benchmark_text = "Excellent match (< 1.0 Å)"
    elif rmsd <= 3.0:
        benchmark_text = "Good match (1.0–3.0 Å)"
    else:
        benchmark_text = "Notable differences (> 3.0 Å)"
    print(f"Interpretation: {benchmark_text}")

    low_confidence_count = sum(score < 70 for score in all_plddt_scores)
    print(f"AlphaFold residues with pLDDT < 70: {low_confidence_count}/{len(all_plddt_scores)}")

    print("\nFiles written")
    print("-------------")
    for path in [
        reference_copy_path,
        aligned_pred_path,
        distance_plot_path,
        plddt_plot_path,
        correlation_plot_path,
        csv_path,
        pymol_script_path,
        html_path,
    ]:
        print(path.name)
    print(html_status)

    try:
        webbrowser.open(html_path.resolve().as_uri())
    except Exception:
        pass


if __name__ == "__main__":
    main()
