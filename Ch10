    print("2 = Group 2")
    print("3 = Group 3 (13)")
    print("4 = Group 4 (14)")
    print("5 = Group 5 (15)")
    print("6 = Group 6 (16)")
    print("7 = Group 7 (17)")
    print("8 = Group 8 (18, Noble Gases)")

    choice = input("Choose a group (1-8): ").strip()
    group_info = get_group_data(choice)

    if group_info is None:
        print("Invalid choice. Please run again and enter a number from 1 to 8.")
        return

    rows = group_info["rows"]
    raw_filename = group_info["raw"]
    fixed_filename = group_info["fixed"]
    title_prefix = group_info["title"]

    create_csv(rows, raw_filename)
    df = load_check_clean(raw_filename, fixed_filename)
    interactive_kmeans_plot(df, title_prefix)


if __name__ == "__main__":
    main()
