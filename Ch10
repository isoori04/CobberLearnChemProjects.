def create_csv(rows, raw_filename):
    with open(raw_filename, mode="w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow([
            "element_name",
            "symbol",
            "atomic_number",
            "atomic_radius_pm",
            "first_ionization_energy_kj_per_mol"
        ])
        writer.writerows(rows)
    print(f"\n{raw_filename} created.")


def load_check_clean(raw_filename, fixed_filename):
    pd.set_option("display.max_columns", None)
    pd.set_option("display.width", 1200)

    df = pd.read_csv(raw_filename)

    print("\n=== RAW DATA CHECK ===")
    print("Shape:", df.shape)
    print("Columns:", list(df.columns))
    print(df)
    print("\nMissing values per column:")
    print(df.isnull().sum())
    print("\nData types:")
    print(df.dtypes)

    # Clean common issues
    df.columns = df.columns.str.strip()

    for col in ["element_name", "symbol"]:
        if col in df.columns:
            df[col] = df[col].astype(str).str.strip()

    numeric_cols = [
        "atomic_number",
        "atomic_radius_pm",
        "first_ionization_energy_kj_per_mol"
    ]
    for col in numeric_cols:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    print("\n=== CLEANED DATA CHECK ===")
    print(df)
    print("\nMissing values after cleaning:")
    print(df.isnull().sum())
    print("\nData types after cleaning:")
    print(df.dtypes)

    df.to_csv(fixed_filename, index=False, encoding="utf-8")
    print(f"\nSaved cleaned file as {fixed_filename}")

    df = df.dropna(subset=["atomic_radius_pm", "first_ionization_energy_kj_per_mol"]).copy()
    return df


def interactive_kmeans_plot(df, title_prefix):
    X = df[["atomic_radius_pm", "first_ionization_energy_kj_per_mol"]]

    print("\nInteractive KMeans clustering started.")
    print("Enter an integer k (e.g., 2, 3, 4) or type 'q' to quit.")

    while True:
        user_input = input("\nEnter k (or q to stop): ").strip().lower()

        if user_input in ("q", "quit", "stop", "exit"):
            print("Done clustering.")
            break

        try:
            k = int(user_input)
        except ValueError:
            print("Invalid input. Please enter a whole number or 'q'.")
            continue

        if k < 1:
            print("k must be at least 1.")
            continue
        if k > len(df):
            print(f"k cannot be greater than number of data points ({len(df)}).")
            continue

        kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
        df["cluster"] = kmeans.fit_predict(X)
        centers = kmeans.cluster_centers_

        print(f"\n=== RESULTS FOR k = {k} ===")
        print(df[["element_name", "symbol", "cluster"]].sort_values("cluster").to_string(index=False))
        print("\nCluster centers [atomic_radius_pm, first_ionization_energy_kj_per_mol]:")
        print(centers)

        plt.figure(figsize=(8.5, 5.5))
        plt.scatter(
            df["atomic_radius_pm"],
            df["first_ionization_energy_kj_per_mol"],
            c=df["cluster"],
            cmap="tab10",
            s=120,
            edgecolors="black",
            linewidths=0.7
        )

        for _, row in df.iterrows():
            plt.text(
                row["atomic_radius_pm"] + 1.2,
                row["first_ionization_energy_kj_per_mol"] + 5,
                row["symbol"],
                fontsize=9
            )

        # Large black X cluster centers
        plt.scatter(
            centers[:, 0],
            centers[:, 1],
            marker="X",
            s=340,
            c="black",
            linewidths=1.6,
            label="Cluster centers"
        )

        plt.xlabel("Atomic Radius (pm)")
        plt.ylabel("First Ionization Energy (kJ/mol)")
        plt.title(f"{title_prefix}: KMeans Clustering (k={k})")
        plt.grid(alpha=0.25)
        plt.legend()
        plt.tight_layout()
        plt.show()


