import gymnasium as gym
import numpy as np
import matplotlib.pyplot as plt

# -----------------------------
# 1. Create the FrozenLake environment
# -----------------------------
# Standard 4x4 FrozenLake
env = gym.make("FrozenLake-v1", map_name="4x4")
np.random.seed(42)

# Seed the environment for reproducibility
state, info = env.reset(seed=42)
env.action_space.seed(42)

print("Observation space:", env.observation_space)
print("Number of states:", env.observation_space.n)
print("Action space:", env.action_space)
print("Number of actions:", env.action_space.n)

n_states = env.observation_space.n
n_actions = env.action_space.n

action_names = {
    0: "LEFT",
    1: "DOWN",
    2: "RIGHT",
    3: "UP"
}

# -----------------------------
# 2. Create the Q-table
# -----------------------------
# Rows = states, Columns = actions
q_table = np.zeros((n_states, n_actions))

print("\nInitial Q-table:")
print(q_table)

# -----------------------------
# 3. Hyperparameters
# -----------------------------
episodes = 20000
max_steps = 100
learning_rate = 0.8      # alpha
discount_factor = 0.95   # gamma

# Start random, then gradually reduce exploration
epsilon = 1.0
epsilon_min = 0.01
epsilon_decay = 0.9995

# Track progress
episode_rewards = []
episode_successes = []

# -----------------------------
# 4. Training loop (Q-learning)
# -----------------------------
for episode in range(episodes):
    state, info = env.reset()
    done = False
    total_reward = 0

    while not done:
        # Choose an action:
        # early training = mostly random
        # later training = mostly greedy
        if np.random.rand() < epsilon:
            action = env.action_space.sample()
        else:
            action = int(np.argmax(q_table[state]))

        # Take action
        new_state, reward, terminated, truncated, info = env.step(action)
        done = terminated or truncated

        # Bellman equation update
        best_next_q = np.max(q_table[new_state])
        td_target = reward if done else reward + discount_factor * best_next_q
        td_error = td_target - q_table[state, action]
        q_table[state, action] += learning_rate * td_error

        state = new_state
        total_reward += reward

    # Decay exploration rate
    epsilon = max(epsilon_min, epsilon * epsilon_decay)

    episode_rewards.append(total_reward)
    episode_successes.append(1 if total_reward == 1 else 0)

env.close()

# -----------------------------
# 5. Print the final Q-table
# -----------------------------
np.set_printoptions(precision=3, suppress=True)
print("\nFinal Q-table:")
print(q_table)

# -----------------------------
# 6. Convert learned policy to arrows
# -----------------------------
def q_table_to_policy_grid(q_table, env):
    arrows = {
        0: "←",
        1: "↓",
        2: "→",
        3: "↑"
    }

    desc = env.unwrapped.desc.astype(str)
    policy_grid = []

    for r in range(desc.shape[0]):
        row = []
        for c in range(desc.shape[1]):
            state = r * desc.shape[1] + c
            tile = desc[r, c]

            if tile == "S":
                row.append("S")
            elif tile == "H":
                row.append("H")
            elif tile == "G":
                row.append("G")
            else:
                best_action = int(np.argmax(q_table[state]))
                row.append(arrows[best_action])

        policy_grid.append(row)

    return policy_grid

# Re-create environment so layout metadata is easy to access
policy_env = gym.make("FrozenLake-v1", map_name="4x4")
policy_grid = q_table_to_policy_grid(q_table, policy_env)

print("\nLearned policy grid:")
for row in policy_grid:
    print(" ".join(row))

policy_env.close()

# -----------------------------
# 7. Test the agent (100 episodes, no exploration)
# -----------------------------
test_env = gym.make("FrozenLake-v1", map_name="4x4")
test_env.reset(seed=123)
test_env.action_space.seed(123)

test_episodes = 100
successes = 0

for _ in range(test_episodes):
    state, info = test_env.reset()
    done = False

    for _ in range(max_steps):
        action = int(np.argmax(q_table[state]))  # learned policy only
        new_state, reward, terminated, truncated, info = test_env.step(action)
        state = new_state
        done = terminated or truncated

        if done:
            if reward == 1:
                successes += 1
            break

test_env.close()

success_rate = 100 * successes / test_episodes
print(f"\nSuccess rate over {test_episodes} test episodes: {success_rate:.1f}%")

if success_rate > 70:
    print("Good learning: success rate is above 70%.")
elif success_rate < 30:
    print("Needs improvement: success rate is below 30%. Try more training or tuning hyperparameters.")
else:
    print("Moderate learning: the agent learned something, but could improve with more training.")

# -----------------------------
# 8. Extension: plot learning progress
# -----------------------------
window = 100
moving_avg = np.convolve(episode_successes, np.ones(window) / window, mode="valid")

plt.figure(figsize=(10, 5))
plt.plot(moving_avg)
plt.xlabel("Episode")
plt.ylabel(f"Success rate (moving average over {window} episodes)")
plt.title("FrozenLake Q-Learning Progress")
plt.tight_layout()
plt.show()

# -----------------------------
# 9. Extension: save the Q-table
# -----------------------------
np.save("frozenlake_qtable.npy", q_table)
print("\nSaved Q-table to 'frozenlake_qtable.npy'.")

# Example of loading it back later:
loaded_q_table = np.load("frozenlake_qtable.npy")
print("Reloaded Q-table shape:", loaded_q_table.shape)

# -----------------------------
# 10. Extension: text demo of one policy run
# -----------------------------
render_env = gym.make("FrozenLake-v1", map_name="4x4", render_mode="ansi")
state, info = render_env.reset(seed=7)
done = False

print("\nDemo run using the learned policy:\n")
print(render_env.render())

for _ in range(max_steps):
    action = int(np.argmax(q_table[state]))
    new_state, reward, terminated, truncated, info = render_env.step(action)
    state = new_state
    done = terminated or truncated

    print(f"Action taken: {action_names[action]}")
    print(render_env.render())

    if done:
        if reward == 1:
            print("The agent reached the goal!")
        else:
            print("The agent fell into a hole or the episode ended before reaching the goal.")
        break

render_env.close()
