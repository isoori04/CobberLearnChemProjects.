import os
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from ucimlrepo import fetch_ucirepo

from sklearn.model_selection import train_test_split, GroupShuffleSplit
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.pipeline import Pipeline
from sklearn.linear_model import LogisticRegression
from sklearn.svm import SVC
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    roc_auc_score,
    RocCurveDisplay,
    ConfusionMatrixDisplay
)

# -----------------------------
# 1. Set up folders
# -----------------------------
os.makedirs("outputs", exist_ok=True)
os.makedirs("figures", exist_ok=True)

# -----------------------------
# 2. Fetch UCI Parkinson's dataset
# -----------------------------
parkinsons = fetch_ucirepo(id=174)

X = parkinsons.data.features.copy()
y = parkinsons.data.targets.copy()

print(parkinsons.metadata)
print(parkinsons.variables)

# -----------------------------
# 3. Fix duplicate column names
# -----------------------------
# The UCI loader shortens names and creates duplicate columns.
# These are the actual 22 features in order.
clean_feature_names = [
    "MDVP_Fo_Hz",
    "MDVP_Fhi_Hz",
    "MDVP_Flo_Hz",
    "MDVP_Jitter_percent",
    "MDVP_Jitter_abs",
    "MDVP_RAP",
    "MDVP_PPQ",
    "Jitter_DDP",
    "MDVP_Shimmer",
    "MDVP_Shimmer_dB",
    "Shimmer_APQ3",
    "Shimmer_APQ5",
    "MDVP_APQ",
    "Shimmer_DDA",
    "NHR",
    "HNR",
    "RPDE",
    "DFA",
    "spread1",
    "spread2",
    "D2",
    "PPE"
]

X.columns = clean_feature_names

# Combine features and target into one dataframe
df = X.copy()
df["status"] = y["status"].values
df["diagnosis"] = df["status"].map({0: "Healthy", 1: "Parkinson's"})

# Try to recover subject IDs if available
try:
    ids = parkinsons.data.ids.copy()
    if ids is not None and "name" in ids.columns:
        df["name"] = ids["name"].values
        df["subject_id"] = df["name"].astype(str).str.replace(r"_\d+$", "", regex=True)
except Exception:
    df["subject_id"] = None

print(df.head())
print(df.info())

df.to_csv("outputs/parkinsons_voice_clean.csv", index=False)

# -----------------------------
# 4. Define features and target
# -----------------------------
feature_cols = clean_feature_names

X = df[feature_cols]
y = df["status"]

# -----------------------------
# 5. Figure 1: Class balance
# -----------------------------
plt.figure(figsize=(6, 4))
df["diagnosis"].value_counts().plot(kind="bar")
plt.title("Class Balance in UCI Parkinson's Voice Dataset")
plt.xlabel("Diagnosis")
plt.ylabel("Number of Voice Recordings")
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig("figures/01_class_balance.png", dpi=300)
plt.close()

# -----------------------------
# 6. Find strongest correlated features
# -----------------------------
corr_with_status = (
    df[feature_cols + ["status"]]
    .corr(numeric_only=True)["status"]
    .drop("status")
    .abs()
    .sort_values(ascending=False)
)

print("\nTop features correlated with Parkinson's status:")
print(corr_with_status.head(10))

corr_with_status.to_csv("outputs/feature_correlations_with_status.csv")

top6 = corr_with_status.head(6).index.tolist()
top12 = corr_with_status.head(12).index.tolist()

# -----------------------------
# 7. Figure 2: Boxplots of top features
# -----------------------------
fig, axes = plt.subplots(2, 3, figsize=(14, 8))
axes = axes.flatten()

for ax, col in zip(axes, top6):
    sns.boxplot(data=df, x="diagnosis", y=col, ax=ax)
    sns.stripplot(data=df, x="diagnosis", y=col, ax=ax, alpha=0.4, size=3)
    ax.set_title(col)
    ax.set_xlabel("")
    ax.set_ylabel(col)

plt.suptitle("Top Voice Features by Diagnosis", fontsize=16)
plt.tight_layout()
plt.savefig("figures/02_top_feature_boxplots.png", dpi=300)
plt.close()

# -----------------------------
# 8. Figure 3: Correlation heatmap
# -----------------------------
plt.figure(figsize=(10, 8))
sns.heatmap(df[top12].corr(numeric_only=True), annot=True, cmap="coolwarm", center=0)
plt.title("Correlation Heatmap of Top Voice Features")
plt.tight_layout()
plt.savefig("figures/03_correlation_heatmap.png", dpi=300)
plt.close()

# -----------------------------
# 9. Figure 4: PCA scatterplot
# -----------------------------
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

pca = PCA(n_components=2)
pca_coords = pca.fit_transform(X_scaled)

pca_df = pd.DataFrame({
    "PC1": pca_coords[:, 0],
    "PC2": pca_coords[:, 1],
    "diagnosis": df["diagnosis"]
})

plt.figure(figsize=(7, 5))
sns.scatterplot(data=pca_df, x="PC1", y="PC2", hue="diagnosis", alpha=0.8)
plt.title("PCA of Voice Features")
plt.xlabel(f"PC1 ({pca.explained_variance_ratio_[0] * 100:.1f}% variance)")
plt.ylabel(f"PC2 ({pca.explained_variance_ratio_[1] * 100:.1f}% variance)")
plt.tight_layout()
plt.savefig("figures/04_pca_scatterplot.png", dpi=300)
plt.close()

# -----------------------------
# 10. Train/test split
# -----------------------------
# Use subject-aware split if subject_id exists.
# Otherwise, use regular stratified split.

if "subject_id" in df.columns and df["subject_id"].notna().all():
    groups = df["subject_id"]

    splitter = GroupShuffleSplit(
        n_splits=1,
        test_size=0.25,
        random_state=42
    )

    train_idx, test_idx = next(splitter.split(X, y, groups=groups))

    X_train = X.iloc[train_idx]
    X_test = X.iloc[test_idx]
    y_train = y.iloc[train_idx]
    y_test = y.iloc[test_idx]

    print("\nUsing subject-aware train/test split.")
    print(f"Training subjects: {df.iloc[train_idx]['subject_id'].nunique()}")
    print(f"Testing subjects: {df.iloc[test_idx]['subject_id'].nunique()}")

else:
    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.25,
        random_state=42,
        stratify=y
    )

    print("\nUsing regular stratified train/test split.")

# -----------------------------
# 11. Train multiple ML models
# -----------------------------
models = {
    "Logistic Regression": Pipeline([
        ("scaler", StandardScaler()),
        ("model", LogisticRegression(max_iter=5000, class_weight="balanced"))
    ]),

    "SVM RBF": Pipeline([
        ("scaler", StandardScaler()),
        ("model", SVC(kernel="rbf", probability=True, class_weight="balanced"))
    ]),

    "Random Forest": Pipeline([
        ("model", RandomForestClassifier(
            n_estimators=500,
            random_state=42,
            class_weight="balanced"
        ))
    ]),

    "Gradient Boosting": Pipeline([
        ("model", GradientBoostingClassifier(random_state=42))
    ])
}

results = []
fitted_models = {}

for name, model in models.items():
    model.fit(X_train, y_train)
    fitted_models[name] = model

    y_pred = model.predict(X_test)
    y_prob = model.predict_proba(X_test)[:, 1]

    results.append({
        "Model": name,
        "Accuracy": accuracy_score(y_test, y_pred),
        "Precision": precision_score(y_test, y_pred, zero_division=0),
        "Recall": recall_score(y_test, y_pred, zero_division=0),
        "F1": f1_score(y_test, y_pred, zero_division=0),
        "ROC_AUC": roc_auc_score(y_test, y_prob)
    })

results_df = pd.DataFrame(results).sort_values("ROC_AUC", ascending=False)

print("\nModel results:")
print(results_df)

results_df.to_csv("outputs/model_performance.csv", index=False)

# -----------------------------
# 12. Figure 5: Model comparison
# -----------------------------
plt.figure(figsize=(8, 5))
sns.barplot(data=results_df, x="ROC_AUC", y="Model")
plt.title("Model Comparison Using ROC AUC")
plt.xlabel("ROC AUC")
plt.ylabel("")
plt.xlim(0, 1)
plt.tight_layout()
plt.savefig("figures/05_model_comparison_auc.png", dpi=300)
plt.close()

# -----------------------------
# 13. Figure 6: ROC curves
# -----------------------------
fig, ax = plt.subplots(figsize=(7, 6))

for name, model in fitted_models.items():
    RocCurveDisplay.from_estimator(model, X_test, y_test, name=name, ax=ax)

plt.title("ROC Curves for Parkinson's Voice Classification")
plt.tight_layout()
plt.savefig("figures/06_roc_curves.png", dpi=300)
plt.close()

# -----------------------------
# 14. Figure 7: Confusion matrix for best model
# -----------------------------
best_model_name = results_df.iloc[0]["Model"]
best_model = fitted_models[best_model_name]

fig, ax = plt.subplots(figsize=(5, 5))
ConfusionMatrixDisplay.from_estimator(
    best_model,
    X_test,
    y_test,
    display_labels=["Healthy", "Parkinson's"],
    cmap="Blues",
    ax=ax
)

plt.title(f"Confusion Matrix: {best_model_name}")
plt.tight_layout()
plt.savefig("figures/07_confusion_matrix_best_model.png", dpi=300)
plt.close()

# -----------------------------
# 15. Figure 8: Random forest feature importance
# -----------------------------
rf = fitted_models["Random Forest"].named_steps["model"]

importance_df = pd.DataFrame({
    "Feature": feature_cols,
    "Importance": rf.feature_importances_
}).sort_values("Importance", ascending=False)

importance_df.to_csv("outputs/random_forest_feature_importance.csv", index=False)

plt.figure(figsize=(9, 6))
sns.barplot(data=importance_df.head(12), x="Importance", y="Feature")
plt.title("Top Random Forest Feature Importances")
plt.xlabel("Importance")
plt.ylabel("")
plt.tight_layout()
plt.savefig("figures/08_random_forest_feature_importance.png", dpi=300)
plt.close()

print("\nDone. Check your outputs/ and figures/ folders.")
