def prompt_float(prompt_text: str, default_value: float) -> float:
    while True:
        raw = input(f"{prompt_text} [{default_value}]: ").strip()
        if raw == "":
            return float(default_value)
        try:
            return float(raw)
        except ValueError:
            print("Please enter a valid number.")


def run_custom_prediction_loop(model: object, default_values: pd.Series) -> None:
    """
    Let the user enter custom values and get repeated predictions in one session.
    """
    print_header("CUSTOM PREDICTION LOOP")
    print("Press Enter to accept the default value shown in brackets.\n")

    feature_prompts = {
        "MedInc": "Median income in block group",
        "HouseAge": "Median house age",
        "AveRooms": "Average number of rooms",
        "AveBedrms": "Average number of bedrooms",
        "Population": "Block group population",
        "AveOccup": "Average occupants per household",
        "Latitude": "Latitude",
        "Longitude": "Longitude",
    }

    while True:
        answer = input("Would you like to predict a custom house price? (y/n): ").strip().lower()
        if answer not in {"y", "yes"}:
            print("Finished. Thanks for exploring the California housing models!")
            break

        new_house = {}
        for feature in default_values.index:
            new_house[feature] = prompt_float(
                feature_prompts[feature],
                float(default_values[feature]),
            )

        new_house_df = pd.DataFrame([new_house])
        prediction = model.predict(new_house_df)[0]

        print("\nPrediction:")
        print(f"Predicted median house value: {prediction:.3f} (in $100,000s)")
        print(f"Predicted median house value: ${prediction * 100000:,.2f}\n")


def main() -> None:
    print_header("CALIFORNIA HOUSING REGRESSION PROJECT")

    X, y, description = load_dataset()
    preview_dataset(X, y, description)

    save_histograms(X, y)
    target_corr = save_correlation_heatmap(X, y)

    print_header("CORRELATIONS WITH MEDIAN HOUSE VALUE")
    print(target_corr.round(3).to_string())

    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=TEST_SIZE,
        random_state=RANDOM_STATE,
    )

    results_df, fitted_models = evaluate_models(X_train, X_test, y_train, y_test)

    print_header("MODEL RANKING")
    print(results_df.round(4).to_string(index=False))

    baseline_best_name = results_df.loc[0, "Model"]
    baseline_best_model = fitted_models[baseline_best_name]
    baseline_best_r2 = float(results_df.loc[0, "R2"])

    tuned_rf_grid = tune_random_forest(X_train, y_train)
    tuned_rf_r2, _ = evaluate_tuned_model(tuned_rf_grid.best_estimator_, X_test, y_test)

    final_model_name = baseline_best_name
    final_model = baseline_best_model

    if tuned_rf_r2 > baseline_best_r2:
        final_model_name = "Tuned Random Forest Regressor"
        final_model = tuned_rf_grid.best_estimator_

    print_header("FINAL MODEL SELECTION")
    print(f"Selected best model: {final_model_name}")

    run_cross_validation(final_model_name, final_model, X, y)
    save_predicted_vs_actual_plot(final_model, X_test, y_test)
    save_feature_importance_plot(final_model, X_test, y_test)
    make_sample_predictions(final_model)
    run_custom_prediction_loop(final_model, X.median())


if __name__ == "__main__":
    main()
